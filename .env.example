# Copy this file to .env and fill in your own keys. Never commit .env.

# OpenAI: the agent (gpt-4.1-mini) and the eval judge (gpt-4.1)
OPENAI_API_KEY=

# Langfuse: tracing. Leave these empty to run without traces (that's what CI does).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
